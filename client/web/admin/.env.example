# The DEEMO server's base URL (the Cloudflare tunnel keeps the /api prefix; locally use http://localhost:3000).
NEXT_PUBLIC_API_URL=https://api.deemo-ai.com/api
# Firebase console > Project settings > Your apps > add a Web app; copy its config here (same project as the mobile app).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
