{
  "expo": {
    "name": "Deemo",
    "slug": "Deemo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "deemo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "ai.deemo.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Bricolage Grotesque",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/bricolage-grotesque/500Medium/BricolageGrotesque_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/bricolage-grotesque/600SemiBold/BricolageGrotesque_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/bricolage-grotesque/700Bold/BricolageGrotesque_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/bricolage-grotesque/800ExtraBold/BricolageGrotesque_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              },
              {
                "fontFamily": "DM Sans",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/dm-sans/400Regular/DMSans_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/dm-sans/500Medium/DMSans_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/dm-sans/600SemiBold/DMSans_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/dm-sans/700Bold/DMSans_700Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "DM Mono",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/dm-mono/400Regular/DMMono_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/dm-mono/500Medium/DMMono_500Medium.ttf",
                    "weight": 500
                  }
                ]
              },
              {
                "fontFamily": "Material Symbols Rounded",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/material-symbols-rounded/400Regular/MaterialSymbolsRounded_400Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Material Symbols Rounded Filled",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/material-symbols-rounded/400Regular_Filled/MaterialSymbolsRounded_400Regular_Filled.ttf",
                    "weight": 400
                  }
                ]
              }
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
