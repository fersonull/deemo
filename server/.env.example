GEMINI_API_KEY=
PORT=3000
# Path to the Firebase service-account JSON (Firebase console > Project settings > Service accounts > Generate new private key),
# or the JSON itself on one line (a host like Render, where there is no file to point at).
# Firebase is used for sign-in only (verifying ID tokens, renaming and deleting the Firebase user).
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
# PostgreSQL connection string (Prisma Postgres: console.prisma.io > your database > Connect). All app data lives here.
# Apply the schema with `bun run db:migrate` (development) or `bun run db:deploy` (a deployed server).
DATABASE_URL=
# Web admin (client/web/admin): its hosted origin(s), comma-separated, e.g. https://deemo-admin.vercel.app.
# http://localhost:3001 is always allowed for local development.
ADMIN_ORIGINS=
